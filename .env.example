# Copy to .env and fill in the two keys. This one file configures everything.
SARVAM_API_KEY=
OPENAI_API_KEY=                     # plans, scripts and draws the whiteboard scenes

LLM_PROVIDER=openai
LLM_MODEL_MAIN=gpt-5.5
LLM_MODEL_FAST=gpt-5.4-mini
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mindsketch_tutor         # the icon library is imported into it on first start
RENDER_SERVICE_URL=http://localhost:3100
MEDIA_DIR=./media                   # = backend/media
TTS_VOICE=en-US-AndrewNeural
TUTOR_PORT=8100
